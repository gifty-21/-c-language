#include <stdio.h>

int main() {
    int n;
    // Read the number of elements
    if (scanf("%d", &n) != 1) return 0;

    int current_val = 0;
    // Loop through all inputs to reach the final element
    for (int i = 0; i < n; i++) {
        scanf("%d", &current_val);
    }

    // Check if the last digit of the very last element is 0
    if (current_val % 10 == 0) {
        printf("Yes\n");
    } else {
        printf("No\n");
    }

    return 0;
}
