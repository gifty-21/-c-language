#include <stdlib.h>

// Structure to preserve original index positional data during sorting
typedef struct {
    int value;
    int index;
} Element;

// Comparator helper function for qsort
int compare(const void* a, const void* b) {
    int val_a = ((Element*)a)->value;
    int val_b = ((Element*)b)->value;
    if (val_a < val_b) return -1;
    if (val_a > val_b) return 1;
    return 0;
}

int* twoSum(int* nums, int numsSize, int target, int* returnSize) {
    // Array allocation to copy elements and indices safely
    Element* elements = (Element*)malloc(numsSize * sizeof(Element));
    for (int i = 0; i < numsSize; i++) {
        elements[i].value = nums[i];
        elements[i].index = i;
    }
    
    // Sort array elements in O(n log n)
    qsort(elements, numsSize, sizeof(Element), compare);
    
    // Two pointer logic: one from head, one from tail
    int left = 0;
    int right = numsSize - 1;
    int* result = (int*)malloc(2 * sizeof(int));
    *returnSize = 2;
    
    while (left < right) {
        long long current_sum = (long long)elements[left].value + elements[right].value;
        
        if (current_sum == target) {
            result[0] = elements[left].index;
            result[1] = elements[right].index;
            free(elements);
            return result;
        } else if (current_sum < target) {
            left++; // Need a larger sum
        } else {
            right--; // Need a smaller sum
        }
    }
    
    free(elements);
    *returnSize = 0;
    return NULL;
}
