#include <stdbool.h>

void setZeroes(int** matrix, int matrixSize, int* matrixColSize) {
    int rows = matrixSize;
    int cols = matrixColSize[0];
    bool first_col_has_zero = false;
    
    // Step 1: Scan the matrix and mark status in the first row and column
    for (int r = 0; r < rows; r++) {
        // Separately check if the first column has any zeroes
        if (matrix[r][0] == 0) {
            first_col_has_zero = true;
        }
        
        // Check the rest of the cells to update tracking row/col
        for (int c = 1; c < cols; c++) {
            if (matrix[r][c] == 0) {
                matrix[r][0] = 0; // Mark row
                matrix[0][c] = 0; // Mark column
            }
        }
    }
    
    // Step 2: Iterate backwards or skip the first row/col to update cells
    // We update from row 1 and column 1 so we don't overwrite our tracking markers prematurely
    for (int r = 1; r < rows; r++) {
        for (int c = 1; c < cols; c++) {
            if (matrix[r][0] == 0 || matrix[0][c] == 0) {
                matrix[r][c] = 0;
            }
        }
    }
    
    // Step 3: Update the first row if matrix[0][0] was flagged as zero
    if (matrix[0][0] == 0) {
        for (int c = 0; c < cols; c++) {
            matrix[0][c] = 0;
        }
    }
    
    // Step 4: Update the first column if our flag was set to true
    if (first_col_has_zero) {
        for (int r = 0; r < rows; r++) {
            matrix[r][0] = 0;
        }
    }
}
