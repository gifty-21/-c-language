#include <stdio.h>
#include <stdlib.h>

#define MAXN 100005

int pref0[MAXN];
int pref1[MAXN];

void solve() {
    int n;
    if (scanf("%d", &n) != 1) return;
    
    pref0[0] = 0;
    pref1[0] = 0;
    
    for (int i = 1; i <= n; i++) {
        int val;
        scanf("%d", &val);
        
        // Build prefix counts
        pref0[i] = pref0[i - 1] + (val == 0);
        pref1[i] = pref1[i - 1] + (val == 1);
    }
    
    int q;
    if (scanf("%d", &q) != 1) return;
    
    while (q--) {
        int l, r;
        scanf("%d %d", &l, &r);
        
        long long m = r - l + 1;
        long long total_pairs = (m * (m - 1)) / 2;
        
        // Count 0s and 1s in the range [l, r] using prefix sums
        long long c0 = pref0[r] - pref0[l - 1];
        long long c1 = pref1[r] - pref1[l - 1];
        
        // Calculate invalid pairs where sum < 2
        long long invalid_pairs = (c0 * (c0 - 1)) / 2 + (c0 * c1);
        
        long long valid_pairs = total_pairs - invalid_pairs;
        printf("%lld\n", valid_pairs);
    }
}

int main() {
    // Optimise standard I/O streams for competitive programming speed
    setvbuf(stdout, NULL, _IOFBF, 16384);
    
    int t;
    if (scanf("%d", &t) != 1) return 0;
    while (t--) {
        solve();
    }
    return 0;
}
