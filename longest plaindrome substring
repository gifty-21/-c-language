#include <stdio.h>
#include <string.h>

// Helper function to expand around a given centre and return the length
int expandAroundCenter(char* s, int left, int right, int len) {
    while (left >= 0 && right < len && s[left] == s[right]) {
        left--;
        right++;
    }
    // Return the length of the palindrome found
    return right - left - 1;
}

char* longestPalindrome(char* s) {
    int len = strlen(s);
    if (len < 1) return "";
    
    int start = 0, max_len = 0;
    
    for (int i = 0; i < len; i++) {
        // Case 1: Odd length palindrome (e.g., "babad" centered at 'a')
        int len1 = expandAroundCenter(s, i, i, len);
        // Case 2: Even length palindrome (e.g., "cbbd" centered between 'b' and 'b')
        int len2 = expandAroundCenter(s, i, i + 1, len);
        
        int curr_max = (len1 > len2) ? len1 : len2;
        
        if (curr_max > max_len) {
            max_len = curr_max;
            // Calculate the starting index of this substring
            start = i - (curr_max - 1) / 2;
        }
    }
    
    // Terminate the string at the end of the longest palindrome to return it directly
    s[start + max_len] = '\0';
    return &s[start];
}
