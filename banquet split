#include <stdio.h>
#include <stdlib.h>

#define MAXN 100005
#define LOGN 18

typedef struct Edge {
    int to;
    struct Edge* next;
} Edge;

Edge* head[MAXN];
int color[MAXN];
int depth[MAXN];
int up[MAXN][LOGN];

void add_edge(int u, int v) {
    Edge* e = (Edge*)malloc(sizeof(Edge));
    e->to = v;
    e->next = head[u];
    head[u] = e;
}

// DFS to compute colors, depths, and binary lifting table for LCA
void dfs(int u, int p, int c, int d) {
    color[u] = c;
    depth[u] = d;
    up[u][0] = p;
    
    for (int i = 1; i < LOGN; i++) {
        if (up[u][i - 1] != -1) {
            up[u][i] = up[up[u][i - 1]][i - 1];
        } else {
            up[u][i] = -1;
        }
    }
    
    for (Edge* e = head[u]; e != NULL; e = e->next) {
        if (e->to != p) {
            dfs(e->to, u, 1 - c, d + 1);
        }
    }
}

// Function to find Lowest Common Ancestor (LCA)
int get_lca(int u, int v) {
    if (depth[u] < depth[v]) {
        int temp = u; u = v; v = temp;
    }
    
    // Lift u to the same depth as v
    for (int i = LOGN - 1; i >= 0; i--) {
        if (depth[u] - (1 << i) >= depth[v]) {
            u = up[u][i];
        }
    }
    
    if (u == v) return u;
    
    // Lift both until they are just below the LCA
    for (int i = LOGN - 1; i >= 0; i--) {
        if (up[u][i] != up[v][i]) {
            u = up[u][i];
            v = up[v][i];
        }
    }
    
    return up[u][0];
}

void solve() {
    int n;
    if (scanf("%d", &n) != 1) return;
    
    for (int i = 1; i <= n; i++) head[i] = NULL;
    
    for (int i = 0; i < n - 1; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        add_edge(u, v);
        add_edge(v, u);
    }
    
    // Populate structure arrays via root node 1
    dfs(1, -1, 0, 0);
    
    int q;
    if (scanf("%d", &q) != 1) return;
    
    while (q--) {
        int x, y;
        scanf("%d %d", &x, &y);
        
        if (color[x] != color[y]) {
            printf("Yes\n");
        } else {
            printf("No\n");
            int lca = get_lca(x, y);
            int path_edges = depth[x] + depth[y] - 2 * depth[lca];
            // Minimum relations to remove is 1, total ways is path_edges + 1
            printf("1 %d\n", path_edges + 1);
        }
    }
    
    // Clean up allocated memory for this test case
    for (int i = 1; i <= n; i++) {
        Edge* curr = head[i];
        while (curr != NULL) {
            Edge* tmp = curr;
            curr = curr->next;
            free(tmp);
        }
    }
}

int main() {
    int t;
    if (scanf("%d", &t) != 1) return 0;
    while (t--) {
        solve();
    }
    return 0;
}
