#include <stdio.h>
#include <stdlib.h>

void solve() {
    int n;
    if (scanf("%d", &n) != 1) return;
    
    long long total_sum = 0;
    long long min_plus_ops = 0;
    
    for (int i = 0; i < n; i++) {
        long long val;
        scanf("%lld", &val);
        total_sum += val;
        
        // If the value is negative, calculate the minimum +2 operations it needs
        if (val < 0) {
            // Ceiling division of (-val / 2)
            min_plus_ops += (-val + 1) / 2;
        }
    }
    
    // Condition 1: If total sum is positive, we cannot reduce it to 0
    if (total_sum > 0) {
        printf("-1\n");
        return;
    }
    
    long long k = -total_sum;
    
    // Condition 2: If the required +2 operations exceed total operations allowed
    if (min_plus_ops > k) {
        printf("-1\n");
    } else {
        printf("%lld\n", k);
    }
}

int main() {
    int t;
    if (scanf("%d", &t) != 1) return 0;
    while (t--) {
        solve();
    }
    return 0;
}
