#include <stdio.h>
#include <stdbool.h>
#include <string.h>

bool isMatch(char* s, char* p) {
    int m = strlen(s);
    int n = strlen(p);
    
    // dp[i][j] will be true if s[0..i-1] matches p[0..j-1]
    bool dp[m + 1][n + 1];
    memset(dp, false, sizeof(dp));
    
    // Base case: Empty string matches empty pattern
    dp[0][0] = true;
    
    // Base case: Deals with patterns like a*, a*b*, or .* that can match an empty string
    for (int j = 2; j <= n; j++) {
        if (p[j - 1] == '*') {
            dp[0][j] = dp[0][j - 2];
        }
    }
    
    // Fill the DP table
    for (int i = 1; i <= m; i++) {
        for (int j = 1; j <= n; j++) {
            // Case 1: Elements match exactly or pattern has '.'
            if (p[j - 1] == s[i - 1] || p[j - 1] == '.') {
                dp[i][j] = dp[i - 1][j - 1];
            } 
            // Case 2: Pattern has '*'
            else if (p[j - 1] == '*') {
                // Subcase A: Match 0 instances of the character preceding '*'
                dp[i][j] = dp[i][j - 2];
                
                // Subcase B: Match 1 or more instances if the preceding character matches s[i-1]
                if (p[j - 2] == s[i - 1] || p[j - 2] == '.') {
                    dp[i][j] = dp[i][j] || dp[i - 1][j];
                }
            }
        }
    }
    
    return dp[m][n];
}
