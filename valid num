#include <stdbool.h>
#include <ctype.h>

bool isNumber(char* s) {
    bool seenDigit = false;
    bool seenDot = false;
    bool seenE = false;

    for (int i = 0; s[i] != '\0'; i++) {
        char ch = s[i];

        if (isdigit(ch)) {
            seenDigit = true;
        } 
        else if (ch == '+' || ch == '-') {
            // Signs can only appear at index 0 or immediately after an 'e' or 'E'
            if (i > 0 && s[i - 1] != 'e' && s[i - 1] != 'E') {
                return false;
            }
        } 
        else if (ch == 'e' || ch == 'E') {
            // 'e'/'E' cannot repeat, and we must have seen a digit before it
            if (seenE || !seenDigit) {
                return false;
            }
            seenE = true;
            seenDigit = false; // Reset to ensure a valid integer follows 'e'
        } 
        else if (ch == '.') {
            // '.' cannot repeat, and cannot appear after an 'e'/'E'
            if (seenDot || seenE) {
                return false;
            }
            seenDot = true;
        } 
        else {
            // Any other character (alphabets, special symbols) is automatically invalid
            return false;
        }
    }

    // The string is valid only if it successfully ends after a valid digit sequence
    return seenDigit;
}
