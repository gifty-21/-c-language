#include <stdbool.h>

bool isValidSudoku(char** board, int boardSize, int* boardColSize) {
    // Arrays to hold bitmasks for each row, column, and 3x3 box
    int rows[9] = {0};
    int cols[9] = {0};
    int boxes[9] = {0};
    
    for (int r = 0; r < 9; r++) {
        for (int c = 0; c < 9; c++) {
            char val = board[r][c];
            
            // Skip empty cells
            if (val == '.') {
                continue;
            }
            
            // Convert character digit to integer value
            int num = val - '0';
            // Create a bitmask representation (e.g., number 5 becomes binary 100000)
            int bit = 1 << num;
            
            // Determine which 3x3 box the cell belongs to
            int box_idx = (r / 3) * 3 + (c / 3);
            
            // Check if the bit is already set in the current row, column, or box
            if ((rows[r] & bit) || (cols[c] & bit) || (boxes[box_idx] & bit)) {
                return false;
            }
            
            // Record the number by updating the masks using bitwise OR
            rows[r] |= bit;
            cols[c] |= bit;
            boxes[box_idx] |= bit;
        }
    }
    
    return true;
}
