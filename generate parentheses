#include <stdlib.h>
#include <string.h>

void backtrack(int n, int open, int close, char* current_str, int index, char** result, int* returnSize) {
    
    if (index == 2 * n) {
        current_str[index] = '\0'; 
        result[*returnSize] = strdup(current_str); 
        (*returnSize)++;
        return;
    }
    
    if (open < n) {
        current_str[index] = '(';
        backtrack(n, open + 1, close, current_str, index + 1, result, returnSize);
    }
    
    if (close < open) {
        current_str[index] = ')';
        backtrack(n, open, close + 1, current_str, index + 1, result, returnSize);
    }
}

char** generateParenthesis(int n, int* returnSize) {
    
    int max_combinations = 5000; 
    char** result = (char**)malloc(max_combinations * sizeof(char*));
    *returnSize = 0;
    
    char* current_str = (char*)malloc((2 * n + 1) * sizeof(char));
  
    backtrack(n, 0, 0, current_str, 0, result, returnSize);
    
    free(current_str);
    
    return result;
}
