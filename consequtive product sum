#include <stdio.h>
#include <stdlib.h>

#define MOD 1000000007

void solve() {
    int n;
    if (scanf("%d", &n) != 1) return;

    long long* a = (long long*)malloc(n * sizeof(long long));
    for (int i = 0; i < n; i++) {
        scanf("%lld", &a[i]);
        a[i] = (a[i] % MOD + MOD) % MOD; // Handle negative inputs cleanly
    }

    // Precompute powers of 2 modulo 10^9 + 7
    long long* pow2 = (long long*)malloc((n + 1) * sizeof(long long));
    pow2[0] = 1;
    for (int i = 1; i <= n; i++) {
        pow2[i] = (pow2[i - 1] * 2) % MOD;
    }

    long long total_score = 0;
    long long prefix_sum_weighted = 0;

    for (int j = 0; j < n; j++) {
        if (j > 0) {
            // Calculate contribution of A[j] paired with all valid previous A[i]
            long long ways_after = pow2[n - 1 - j];
            long long current_contribution = (a[j] * ways_after) % MOD;
            current_contribution = (current_contribution * prefix_sum_weighted) % MOD;
            
            total_score = (total_score + current_contribution) % MOD;
        }
        
        // Update the running prefix sum: S[j+1] = S[j] + A[j] * 2^j
        long long current_term = (a[j] * pow2[j]) % MOD;
        prefix_sum_weighted = (prefix_sum_weighted + current_term) % MOD;
    }

    printf("%lld\n", total_score);

    free(a);
    free(pow2);
}

int main() {
    // Optimise standard I/O streams for competitive programming speed
    setvbuf(stdout, NULL, _IOFBF, 16384);
    
    int t;
    if (scanf("%d", &t) != 1) return 0;
    while (t--) {
        solve();
    }
    return 0;
}
