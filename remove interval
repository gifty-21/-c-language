#include <stdio.h>
#include <stdlib.h>

// Comparison function for qsort
int compare(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

// Binary search to find number of elements strictly less than target
int count_strictly_less(int* arr, int n, int target) {
    int low = 0, high = n - 1;
    int ans = 0;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (arr[mid] < target) {
            ans = mid + 1; // All elements from 0 to mid are strictly less
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    return ans;
}

// Binary search to find number of elements strictly greater than target
int count_strictly_greater(int* arr, int n, int target) {
    int low = 0, high = n - 1;
    int ans = 0;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (arr[mid] > target) {
            ans = n - mid; // All elements from mid to n-1 are strictly greater
            high = mid - 1;
        } else {
            low = mid + 1;
        }
    }
    return ans;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int* L = (int*)malloc(n * sizeof(int));
    int* R = (int*)malloc(n * sizeof(int));
    int* sorted_L = (int*)malloc(n * sizeof(int));
    int* sorted_R = (int*)malloc(n * sizeof(int));

    for (int i = 0; i < n; i++) {
        scanf("%d %d", &L[i], &R[i]);
        sorted_L[i] = L[i];
        sorted_R[i] = R[i];
    }

    // Sort arrays to enable O(log N) binary search queries
    qsort(sorted_L, n, sizeof(int), compare);
    qsort(sorted_R, n, sizeof(int), compare);

    int min_removal_cost = n; // Initialise with a worst-case boundary maximum

    for (int i = 0; i < n; i++) {
        // Intervals that end strictly before L[i] begins
        int before = count_strictly_less(sorted_R, n, L[i]);
        
        // Intervals that start strictly after R[i] ends
        int after = count_strictly_greater(sorted_L, n, R[i]);

        // Overlapping count = total - non-overlapping - itself
        int overlap_count = n - before - after - 1;

        if (overlap_count < min_removal_cost) {
            min_removal_cost = overlap_count;
        }
    }

    printf("%d\n", min_removal_cost);

    // Free all dynamic storage allocations
    free(L); free(R);
    free(sorted_L); free(sorted_R);

    return 0;
}
