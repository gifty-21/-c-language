#include <limits.h>

int myAtoi(char* s) {
    int i = 0;
    int sign = 1;
    int result = 0;

    // Step 1: Discard leading whitespaces
    while (s[i] == ' ') {
        i++;
    }

    // Step 2: Check for sign signifier
    if (s[i] == '+' || s[i] == '-') {
        if (s[i] == '-') {
            sign = -1;
        }
        i++;
    }

    // Step 3: Convert digits and handle clamping
    while (s[i] >= '0' && s[i] <= '9') {
        int digit = s[i] - '0';

        // Check for 32-bit signed overflow conditions
        if (result > INT_MAX / 10 || (result == INT_MAX / 10 && digit > INT_MAX % 10)) {
            return (sign == 1) ? INT_MAX : INT_MIN;
        }

        result = result * 10 + digit;
        i++;
    }

    return result * sign;
}
