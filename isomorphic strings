#include <stdbool.h>
#include <string.h>

bool isIsomorphic(char* s, char* t) {
    // Array trackers initialized to 0 (unseen state marker)
    int mapS[256] = {0};
    int mapT[256] = {0};
    
    int len = strlen(s);
    
    for (int i = 0; i < len; i++) {
        // Cast to unsigned char to safely map ASCII character values to indexes 0-255
        unsigned char charS = (unsigned char)s[i];
        unsigned char charT = (unsigned char)t[i];
        
        // If their last seen index tracking positions don't match, it's invalid
        if (mapS[charS] != mapT[charT]) {
            return false;
        }
        
        // Update both charts with current index context (using 1-based index)
        mapS[charS] = i + 1;
        mapT[charT] = i + 1;
    }
    
    return true;
}
