#include <stdbool.h>
#include <string.h>

bool isValid(char* s) {
    int len = strlen(s);
    
    char stack[len];
    int top = -1;
    
    for (int i = 0; s[i] != '\0'; i++) {
        char ch = s[i];
        
        
        if (ch == '(' || ch == '{' || ch == '[') {
            stack[++top] = ch;
        } 
     
        else {
        
            if (top == -1) {
                return false;
            }
            
            char openBracket = stack[top];
            
            if ((ch == ')' && openBracket == '(') ||
                (ch == '}' && openBracket == '{') ||
                (ch == ']' && openBracket == '[')) {
                top--;
            } else {
                return false; 
            }
        }
    }
    
    return top == -1;
}
