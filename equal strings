#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define INF 1000000000000000LL

long long min(long long a, long long b) {
    return (a < b) ? a : b;
}

void solve() {
    int n;
    long long k;
    if (scanf("%d %lld", &n, &k) != 2) return;

    char* a = (char*)malloc((n + 1) * sizeof(char));
    char* b = (char*)malloc((n + 1) * sizeof(char));
    scanf("%s", a);
    scanf("%s", b);

    // Collect all indices where the characters differ
    int* diffs = (int*)malloc(n * sizeof(int));
    int m = 0;
    for (int i = 0; i < n; i++) {
        if (a[i] != b[i]) {
            diffs[m++] = i;
        }
    }

    // If the number of mismatches is odd, it's impossible to equalize
    if (m % 2 != 0) {
        printf("-1\n");
        free(a); free(b); free(diffs);
        return;
    }

    if (m == 0) {
        printf("0\n");
        free(a); free(b); free(diffs);
        return;
    }

    // DP states: dp0 = 0 open elements, dp1 = 1 open element
    long long dp0 = 0;
    long long dp1 = k; // Cost to open the first arbitrary flip

    long long prev_dp0 = 0;
    long long prev_dp1 = INF;

    for (int i = 1; i < m; i++) {
        long long next_dp0 = INF;
        long long next_dp1 = INF;

        // 1. Calculate next_dp0 (0 open elements remaining)
        // Option A: Close an existing open arbitrary flip
        next_dp0 = min(next_dp0, dp1);
        // Option B: Pair current with previous via adjacent flips
        next_dp0 = min(next_dp0, prev_dp0 + (diffs[i] - diffs[i - 1]));
        // Option C: Pair current with previous via a new arbitrary flip
        next_dp0 = min(next_dp0, prev_dp0 + k);

        // 2. Calculate next_dp1 (1 open element remaining)
        // Option A: Start a new open arbitrary flip
        next_dp1 = min(next_dp1, dp0 + k);
        // Option B: Carry over the open flip and pair current with previous via adjacent flips
        next_dp1 = min(next_dp1, prev_dp1 + (diffs[i] - diffs[i - 1]));

        // Rotate variables for the next iteration
        prev_dp0 = dp0;
        prev_dp1 = dp1;
        dp0 = next_dp0;
        dp1 = next_dp1;
    }

    printf("%lld\n", dp0);

    free(a);
    free(b);
    free(diffs);
}

int main() {
    setvbuf(stdout, NULL, _IOFBF, 16384);
    int t;
    if (scanf("%d", &t) != 1) return 0;
    while (t--) {
        solve();
    }
    return 0;
}
