#include <stdio.h>

int majorityElement(int* nums, int numsSize) {
    int candidate = 0;
    int count = 0;
    
    for (int i = 0; i < numsSize; i++) {
        // If count drops to 0, select the current element as the new candidate
        if (count == 0) {
            candidate = nums[i];
        }
        
        // Add 1 if the current element matches candidate, otherwise subtract 1
        if (nums[i] == candidate) {
            count++;
        } else {
            count--;
        }
    }
    
    return candidate;
}
