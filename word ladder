#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

// Helper function to check if two words differ by exactly 1 character
bool isNeighbor(const char* w1, const char* w2, int len) {
    int diff = 0;
    for (int i = 0; i < len; i++) {
        if (w1[i] != w2[i]) {
            diff++;
            if (diff > 1) return false;
        }
    }
    return diff == 1;
}

int ladderLength(char* beginWord, char* endWord, char** wordList, int wordListSize) {
    int wordLen = strlen(beginWord);
    
    // Step 1: Find if endWord is in the wordList
    int endIdx = -1;
    for (int i = 0; i < wordListSize; i++) {
        if (strcmp(wordList[i], endWord) == 0) {
            endIdx = i;
            break;
        }
    }
    // If endWord is not in the list, no transformation sequence is possible
    if (endIdx == -1) return 0;

    // Step 2: Initialize arrays to track visited states and the BFS queue
    // visited[i] = true means wordList[i] has been added to the queue
    bool* visited = (bool*)calloc(wordListSize, sizeof(bool));
    
    // The queue stores indices of words from wordList.
    // We allocate wordListSize + 1 slots to handle the initial state safely.
    int* queue = (int*)malloc((wordListSize + 1) * sizeof(int));
    int head = 0, tail = 0;

    // Step 3: Perform level-by-level BFS
    int stepCount = 1; // The sequence starts with beginWord
    
    // We process the first level out-of-loop using beginWord
    // Look for all direct neighbors of beginWord to seed the queue
    for (int i = 0; i < wordListSize; i++) {
        if (isNeighbor(beginWord, wordList[i], wordLen)) {
            if (i == endIdx) {
                free(visited);
                free(queue);
                return 2; // "beginWord -> endWord" is a 2-word sequence
            }
            queue[tail++] = i;
            visited[i] = true;
        }
    }
    
    // Main BFS traversal loop
    while (head < tail) {
        stepCount++;
        int levelSize = tail - head; // Total elements in the current layer

        // Process all words belonging to the current step level
        for (int k = 0; k < levelSize; k++) {
            int currIdx = queue[head++];
            char* currWord = wordList[currIdx];

            // If we have reached the destination index, return sequence length
            if (currIdx == endIdx) {
                free(visited);
                free(queue);
                return stepCount;
            }

            // Find all unvisited neighbors of the current word
            for (int i = 0; i < wordListSize; i++) {
                if (!visited[i] && isNeighbor(currWord, wordList[i], wordLen)) {
                    queue[tail++] = i;
                    visited[i] = true;
                }
            }
        }
    }

    // Free allocated memory if no path to endWord is found
    free(visited);
    free(queue);
    return 0;
}
