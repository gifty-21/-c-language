#include <stdio.h>

void backtrack(int row, int n, int cols, int diag1, int diag2, int* count) {
    if (row == n) {
        (*count)++;
        return;
    }

    // Get all valid positions in the current row where a queen can be placed.
    // (1 << n) - 1 creates a mask of n ones (e.g., for n=4, 00001111)
    // The bitwise OR groups all blocked columns, then NOT (~) flips them to find open slots.
    int availablePositions = ((1 << n) - 1) & ~(cols | diag1 | diag2);

    while (availablePositions > 0) {
        // Extract the lowest set bit (the rightmost available position)
        int position = availablePositions & -availablePositions;
        
        // Remove this position from the available positions pool
        availablePositions -= position;

        // Recursively move to the next row, shifting diagonals relative to the new row
        backtrack(row + 1, n, 
                  cols | position, 
                  (diag1 | position) << 1, 
                  (diag2 | position) >> 1, 
                  count);
    }
}

int totalNQueens(int n) {
    int count = 0;
    // Kick off backtracking from row 0 with clear bitmasks
    backtrack(0, n, 0, 0, 0, &count);
    return count;
}
