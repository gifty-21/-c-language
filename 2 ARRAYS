#include <stdio.h>
#include <stdlib.h>

// Function to compute Combinations nCr safely using long long
long long nCr(int n, int r) {
    if (r < 0 || r > n) return 0;
    if (r == 0 || r == n) return 1;
    if (r > n / 2) r = n - r; // Optimize computations
    
    long long ans = 1;
    for (int i = 1; i <= r; i++) {
        ans = ans * (n - r + i) / i;
    }
    return ans;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    long long sum_a = 0, sum_b = 0;
    int count_a = 0, count_b = 0;

    // Read Array A
    for (int i = 0; i < n; i++) {
        long long val;
        scanf("%lld", &val);
        if (val == -1) {
            count_a++;
        } else {
            sum_a += val;
        }
    }

    // Read Array B
    for (int i = 0; i < n; i++) {
        long long val;
        scanf("%lld", &val);
        if (val == -1) {
            count_b++;
        } else {
            sum_b += val;
        }
    }

    // Case 1: Both arrays have at least one -1
    if (count_a > 0 && count_b > 0) {
        printf("Infinite\n");
    } 
    // Case 2: Array B has no -1s, meaning the missing values are only in A
    else if (count_b == 0) {
        long long required_x = sum_b - sum_a;
        if (required_x < 0) {
            printf("0\n");
        } else {
            // Stars and Bars formula: C(required_x + count_a - 1, count_a - 1)
            printf("%lld\n", nCr(required_x + count_a - 1, count_a - 1));
        }
    } 
    // Case 3: Array A has no -1s, meaning the missing values are only in B
    else {
        long long required_y = sum_a - sum_b;
        if (required_y < 0) {
            printf("0\n");
        } else {
            // Stars and Bars formula: C(required_y + count_b - 1, count_b - 1)
            printf("%lld\n", nCr(required_y + count_b - 1, count_b - 1));
        }
    }

    return 0;
}
