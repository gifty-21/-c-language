#include <stdio.h>
#include <string.h>

#define MAX_LEN 100005
#define MIN(a, b) ((a) < (b) ? (a) : (b))

void solve() {
    char s[MAX_LEN];
    if (scanf("%s", s) != 1) return;

    int n = strlen(s);
    
    // suffix_close[i] will store the number of ')' from index i to n-1
    int suffix_close[MAX_LEN] = {0};
    int current_close = 0;
    
    for (int i = n - 1; i >= 0; i--) {
        if (s[i] == ')') {
            current_close++;
        }
        suffix_close[i] = current_close;
    }

    int max_super_balanced = 0;
    int open_left = 0;

    // Traverse the string and check balance at each position
    for (int i = 0; i < n; i++) {
        if (s[i] == '(') {
            open_left++;
            
            // Look at remaining closing brackets to the right of this character
            int close_right = (i + 1 < n) ? suffix_close[i + 1] : 0;
            int potential_length = 2 * MIN(open_left, close_right);
            
            if (potential_length > max_super_balanced) {
                max_super_balanced = potential_length;
            }
        }
    }

    printf("%d\n", max_super_balanced);
}

int main() {
    int t;
    if (scanf("%d", &t) == 1) {
        while (t--) {
            solve();
        }
    }
    return 0;
}
