#include <stdio.h>
#include <stdlib.h>

// Helper structure to represent graph edges
typedef struct {
    int u;
    int v;
    int weight;
} Edge;

// Standard GCD calculator
int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

// Comparison function to sort edges in descending order
int compare_edges(const void* a, const void* b) {
    return ((Edge*)b)->weight - ((Edge*)a)->weight;
}

// DSU Find operation with path compression
int find_set(int i, int* parent) {
    if (parent[i] == i)
        return i;
    return parent[i] = find_set(parent[i], parent);
}

// DSU Union operation by rank
void union_sets(int i, int j, int* parent, int* rank) {
    int root_i = find_set(i, parent);
    int root_j = find_set(j, parent);
    if (root_i != root_j) {
        if (rank[root_i] < rank[root_j]) {
            parent[root_i] = root_j;
        } else if (rank[root_i] > rank[root_j]) {
            parent[root_j] = root_i;
        } else {
            parent[root_j] = root_i;
            rank[root_i]++;
        }
    }
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int* a = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    // Number of total combinations/edges in a complete graph is N * (N - 1) / 2
    int num_edges = (n * (n - 1)) / 2;
    Edge* edges = (Edge*)malloc(num_edges * sizeof(Edge));
    int edge_idx = 0;

    // Generate all edges with their corresponding GCD values acting as weights
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            edges[edge_idx].u = i;
            edges[edge_idx].v = j;
            edges[edge_idx].weight = gcd(a[i], a[j]);
            edge_idx++;
        }
    }

    // Sort edges descending by weight to greedily maximize total cost
    qsort(edges, num_edges, sizeof(Edge), compare_edges);

    // Initialise DSU arrays
    int* parent = (int*)malloc(n * sizeof(int));
    int* rank = (int*)calloc(n, sizeof(int));
    for (int i = 0; i < n; i++) {
        parent[i] = i;
    }

    long long max_total_cost = 0;
    int edges_added = 0;

    // Run Kruskal's algorithm variant to build the Maximum Spanning Tree
    for (int i = 0; i < num_edges; i++) {
        if (find_set(edges[i].u, parent) != find_set(edges[i].v, parent)) {
            max_total_cost += edges[i].weight;
            union_sets(edges[i].u, edges[i].v, parent, rank);
            edges_added++;
            
            // Stop once N-1 edges are selected to form a complete tree
            if (edges_added == n - 1) {
                break;
            }
        }
    }

    printf("%lld\n", max_total_cost);

    // Free dynamic allocations
    free(a);
    free(edges);
    free(parent);
    free(rank);

    return 0;
}
