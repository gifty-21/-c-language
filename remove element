int removeElement(int* nums, int numsSize, int val) {
    // 'k' tracks the index where the next valid element should be placed
    int k = 0;
    
    // Scan every element in the array
    for (int i = 0; i < numsSize; i++) {
        // If the current element is not the target value to remove
        if (nums[i] != val) {
            nums[k] = nums[i]; // Move the valid element forward
            k++;               // Increment our valid element count
        }
    }
    
    // k is the total number of elements not equal to val
    return k;
}
