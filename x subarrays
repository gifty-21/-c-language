#include <stdio.h>
#include <stdlib.h>

void solve() {
    int n;
    long long x;
    if (scanf("%d %lld", &n, &x) != 2) return;
    
    long long* a = (long long*)malloc(n * sizeof(long long));
    for (int i = 0; i < n; i++) {
        scanf("%lld", &a[i]);
    }
    
    long long count = 0;
    int l = 0;
    int r = n - 1;
    
    // Two-pointer approach
    while (l <= r) {
        if (a[l] + a[r] <= x) {
            // All subarrays starting at index 'l' and ending anywhere 
            // from 'l' up to 'r' are valid because the array is sorted.
            count += (r - l + 1);
            l++; // Move the left pointer forward
        } else {
            r--; // Sum is too large, move the right pointer backward
        }
    }
    
    printf("%lld\n", count);
    free(a);
}

int main() {
    int t;
    if (scanf("%d", &t) != 1) return 0;
    while (t--) {
        solve();
    }
    return 0;
}
