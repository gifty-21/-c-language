#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <string.h>

// Comparison function for qsort
int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

// Backtracking helper function
void backtrack(int* nums, int numsSize, int* path, bool* used, int pathSize, 
               int*** result, int* returnSize, int* capacity, int** returnColumnSizes) {
    
    // Base case: Found a complete permutation
    if (pathSize == numsSize) {
        if (*returnSize >= *capacity) {
            *capacity *= 2;
            *result = (int**)realloc(*result, (*capacity) * sizeof(int*));
            *returnColumnSizes = (int*)realloc(*returnColumnSizes, (*capacity) * sizeof(int));
        }
        
        (*result)[*returnSize] = (int*)malloc(numsSize * sizeof(int));
        memcpy((*result)[*returnSize], path, numsSize * sizeof(int));
        (*returnColumnSizes)[*returnSize] = numsSize;
        (*returnSize)++;
        return;
    }
    
    for (int i = 0; i < numsSize; i++) {
        // Skip if already used
        if (used[i]) continue;
        
        // Skip duplicates: if the previous identical element was not used, 
        // using the current one would create a duplicate permutation branch.
        if (i > 0 && nums[i] == nums[i - 1] && !used[i - 1]) continue;
        
        // Make choice
        path[pathSize] = nums[i];
        used[i] = true;
        
        // Recursion
        backtrack(nums, numsSize, path, used, pathSize + 1, result, returnSize, capacity, returnColumnSizes);
        
        // Undo choice (backtrack)
        used[i] = false;
    }
}

int** permuteUnique(int* nums, int numsSize, int* returnSize, int** returnColumnSizes) {
    // Step 1: Sort the input array
    qsort(nums, numsSize, sizeof(int), compare);
    
    int capacity = 16;
    int** result = (int**)malloc(capacity * sizeof(int*));
    *returnColumnSizes = (int*)malloc(capacity * sizeof(int));
    *returnSize = 0;
    
    int* path = (int*)malloc(numsSize * sizeof(int));
    bool* used = (bool*)calloc(numsSize, sizeof(bool));
    
    // Step 2: Start backtracking
    backtrack(nums, numsSize, path, used, 0, &result, returnSize, &capacity, returnColumnSizes);
    
    // Clean up local tracking arrays
    free(path);
    free(used);
    
    // Resize down to final exact size
    if (*returnSize == 0) {
        free(result);
        free(*returnColumnSizes);
        *returnColumnSizes = NULL;
        return NULL;
    }
    result = (int**)realloc(result, (*returnSize) * sizeof(int*));
    *returnColumnSizes = (int*)realloc(*returnColumnSizes, (*returnSize) * sizeof(int));
    
    return result;
}
